	(text "ROW A – ALTMODE HEADER\nPin   Net              STM pin    ADC           TIM                         I2C          SPI                    UART\n------------------------------------------------------------------------------------------\na1    Altmode3         PA10 (43)  –             TIM1_CH3                    –            –                      USART1_RX\na2    Altmode2         PA9  (42)  –             TIM1_CH2                    I2C3_SMBA    –                      USART1_TX\na3    Altmode1         PA8  (41)  –             TIM1_CH1                    I2C3_SCL     –                      USART1_CK\na4    Altmode6         PB15 (36)  –             TIM1_CH3N, TIM8/12          –            SPI2_MOSI              –\na5    Altmode5         PB14 (35)  –             TIM1_CH2N, TIM8/12          –            SPI2_MISO              USART3_RTS\na6    Altmode4         PB13 (34)  –             TIM1_CH1N                   –            SPI2_SCK               USART3_CTS\na7    Altmode16        PC4  (24)  ADC12_IN14    –                           –            –                      –\na8    Altmode10        PA3  (17)  ADC123_IN3    TIM2_CH4, TIM5/9            –            –                      USART2_RX\na9    Altmode11        PB7  (59)  –             TIM4_CH2                    I2C1_SDA     –                      USART1_RX\na10   Altmode9         PA2  (16)  ADC123_IN2    TIM2_CH3, TIM5/9            –            –                      USART2_TX\na11   Altmode8         PA1  (15)  ADC123_IN1    TIM2_CH2, TIM5_CH2          –            –                      USART2_RTS, UART4_RX\na12   Altmode7         PA0  (14)  ADC123_IN0    TIM2_CH1_ETR, TIM5/8        –            –                      USART2_CTS, UART4_TX\na13   Altmode15        PC3  (11)  ADC123_IN13   –                           –            SPI2_MOSI              –\na14   Altmode14        PC2  (10)  ADC123_IN12   –                           –            SPI2_MISO              –\na15   Altmode13        PC1  (9)   ADC123_IN11   –                           –            –                      –\na16   Altmode12        PC0  (8)   ADC123_IN10   –                           –            –                      –\n\nROW B – CHAINBUS - Addres & Communication\nPin   Net              STM pin    ADC           TIM                         I2C          SPI                    UART\n------------------------------------------------------------------------------------------\nb1    Chainbus_addr3   PC9  (40)  –             TIM3_CH4, TIM8_CH4          I2C3_SDA     –                      –\nb2    Chainbus_addr4   PB5  (57)  –             TIM3_CH2                    I2C1_SMBA    SPI1_MOSI, SPI3_MOSI   –\nb3    Chainbus_addr0   PA7  (23)  ADC12_IN7     TIM1_CH1N, TIM3/8/14        –            SPI1_MOSI              –\nb4    Chainbus_addr1   PA6  (22)  ADC12_IN6     TIM1/8_BKIN, TIM3/13        –            SPI1_MISO              –\nb5    Chainbus_addr2   PA5  (21)  ADC12_IN5*    TIM2_CH1_ETR, TIM8_CH1N     –            SPI1_SCK               –\nb6    Chainbus_addr5   PC6  (37)  –             TIM3_CH1, TIM8_CH1          –            –                      USART6_TX\nb7    Chainbus_addr6   PC7  (38)  –             TIM3_CH2, TIM8_CH2          –            –                      USART6_RX\nb8    Chainbus_addr7   PC8  (39)  –             TIM3_CH3, TIM8_CH3          –            –                      USART6_CK\nb9    I2C_Memory.SDA   PB11 (30)  –             TIM2_CH4                    I2C2_SDA     –                      USART3_RX\nb10   I2C_Memory.SCL   PB10 (29)  –             TIM2_CH3                    I2C2_SCL     SPI2_SCK               USART3_TX\nb11   Chainbus.CS      PA15 (50)  –             TIM2_CH1_ETR                –            SPI3_NSS, SPI1_NSS     –\nb12   Chainbus.SCK     PB3  (55)  –             TIM2_CH2                    –            SPI3_SCK, SPI1_SCK     –\nb13   Chainbus.MOSI    PC12 (53)  –             –                           –            SPI3_MOSI              USART3_CK, UART5_TX\nb14   Chainbus.MISO    PB4  (56)  –             TIM3_CH1                    –            SPI3_MISO, SPI1_MISO   –\nb15   Chainbus.RX      PC11 (52)  –             –                           –            SPI3_MISO              USART3_RX, UART4_RX\nb16   Chainbus.TX      PC10 (51)  –             –                           –            SPI3_SCK               USART3_TX, UART4_TX"
